{
  "routes": [
    { "handle": "filesystem" },

    { "src": "/api/waitlist$", "dest": "/vercel/api/waitlist.ts" },
    { "src": "/api/waitlist/export$", "dest": "/vercel/api/waitlist/export.ts" },

    { "src": "/((?!api/|assets/|favicon\\.ico$|apple-touch-icon\\.png$|site\\.webmanifest$|robots\\.txt$|sitemap\\.xml$).*)", "dest": "/index.html" }
  ]
}